# HARNESS: copy to backend/.env. GEMINI_API_KEY is the name the Antigravity SDK reads (doc _common.py).
GEMINI_API_KEY=
# Optional: route model calls through tools/gemini_pool.py (CI does this).
# GOOGLE_GEMINI_BASE_URL=http://localhost:8285
# Workspace + session dirs (the showcase defaults live under /data, which only exists in its container).
ANTIGRAVITY_WORKSPACE=./.ws
ANTIGRAVITY_SAVE_DIR=./.sessions
